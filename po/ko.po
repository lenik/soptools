#: src/soptools.cpp:32
msgid ""
"Usage: soptools [OPTIONS] [PROJECTDIR]\n"
"Guide project construction through SOP workflow steps.\n"
msgstr ""

#: src/soptools.cpp:34
msgid "  -s, --sop SOPDIR     SOP directory (default: builtin worldman.sop)\n"
msgstr ""

#: src/soptools.cpp:35
msgid "  -c, --console        console-only mode (no GUI)\n"
msgstr ""

#: src/soptools.cpp:36
msgid "  -g, --gui            force GUI mode\n"
msgstr ""

#: src/soptools.cpp:37
msgid "  -C, --chdir DIR      project directory (default: cwd or nearest .git)\n"
msgstr ""

#: src/soptools.cpp:38
msgid "  -v, --verbose        repeat for more verbose loggings\n"
msgstr ""

#: src/soptools.cpp:39
msgid "  -q, --quiet          show less logging messages\n"
msgstr ""

#: src/soptools.cpp:40
msgid "  -h, --help           display this help and exit\n"
msgstr ""

#: src/soptools.cpp:41
msgid "      --version        output version information and exit\n"
msgstr ""
