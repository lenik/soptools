#!/bin/bash
# sop-script — common settings for SOP shell steps.
# Source from a step script:  . sop-script
#
# sopwin prepends <pkgdatadir>/extension/bash to PATH and exports:
#   SOP_PROJECT_DIR  SOP_DIR  SOP_STEP_ID  SOP_LOGLEVEL  LOGLEVEL
#   SOP_PROGRESS_FIFO  (named pipe for set_progress — this script's progress only)

# shellcheck disable=SC2034
: "${SOP_PROJECT_DIR:=${PWD:-.}}"
: "${SOP_DIR:=}"
: "${SOP_STEP_ID:=}"
: "${SOP_LOGLEVEL:=0}"
: "${LOGLEVEL:=$SOP_LOGLEVEL}"
: "${SOP_PROGRESS_FIFO:=}"

export SOP_PROJECT_DIR SOP_DIR SOP_STEP_ID SOP_LOGLEVEL LOGLEVEL SOP_PROGRESS_FIFO

# Stay in the project tree unless the step already changed directory.
if [ -n "${SOP_PROJECT_DIR}" ] && [ -d "${SOP_PROJECT_DIR}" ]; then
    case "${PWD}/" in
    "${SOP_PROJECT_DIR}"/*) ;;
    *) cd "${SOP_PROJECT_DIR}" || return 1 ;;
    esac
fi

sop_log() {
    local level="${1:-1}"
    shift
    if [ "${LOGLEVEL:-0}" -ge "${level}" ] 2>/dev/null; then
        printf 'sop[%s]: %s\n' "${SOP_STEP_ID:-script}" "$*" >&2
    fi
}

sop_die() {
    printf 'sop[%s]: %s\n' "${SOP_STEP_ID:-script}" "$*" >&2
    exit 1
}

# Report this script's own progress to sopwin (not the whole SOP session).
# Usage: set_progress 10%
#        set_progress 30.78%
#        set_progress 100
set_progress() {
    local raw="${1:-}"
    if [ -z "${raw}" ]; then
        return 0
    fi
    # Normalize: keep digits and one optional decimal; optional trailing %.
    local pct="${raw%"%"}"
    case "${pct}" in
    ''|*[!0-9.]*|*.*.*)
        sop_log 0 "set_progress: invalid value '${raw}'"
        return 1
        ;;
    esac
    if [ -n "${SOP_PROGRESS_FIFO}" ] && [ -p "${SOP_PROGRESS_FIFO}" ]; then
        # One line per update. Failures are ignored if the reader already exited.
        printf 'progress %s%%\n' "${pct}" >"${SOP_PROGRESS_FIFO}" 2>/dev/null || true
    fi
    return 0
}
